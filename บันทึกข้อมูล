ขอโค้ด ที่สามารถหาชื่อเพื่อนได้

การทำให้ช่อง "ค้นหาเพื่อน หรือข้อความ..." ในหน้า Direct Messages สามารถพิมพ์ค้นหาชื่อเพื่อนแล้วกรองรายการแชทแบบเรียลไทม์ได้ทันที สามารถทำได้โดยอัปเดตไฟล์ index.html และ script.js ดังนี้ครับ

1. ไฟล์ index.html (ใส่ id ให้กับช่องค้นหา)
ในไฟล์ index.html ตรงส่วน <div class="ig-dm-search"> ให้เพิ่ม id="dm-search-input" เข้าไปในแท็ก <input>:

HTML
            <!-- Search Bar -->
            <div class="ig-dm-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="dm-search-input" placeholder="ค้นหาเพื่อน หรือข้อความ...">
            </div>
2. ไฟล์ script.js (อัปเดตระบบค้นหาชื่อเพื่อน)
อัปเดตฟังก์ชัน renderChatList และเพิ่ม Event Listener สำหรับช่องค้นหาลงในไฟล์ script.js:

JavaScript
// ปรับปรุงฟังก์ชัน renderChatList ให้รองรับการกรองตามคำค้นหา (filterText)
function renderChatList(filterText = '') {
    const chatList = document.getElementById('ig-chat-list');
    if (!chatList) return;

    // กรองรายชื่อเพื่อนตามชื่อ (name) หรือข้อความล่าสุด (lastMsg)
    const filteredUsers = chatUsersData.filter(user => 
        user.name.toLowerCase().includes(filterText.toLowerCase()) ||
        user.lastMsg.toLowerCase().includes(filterText.toLowerCase())
    );

    if (filteredUsers.length === 0) {
        chatList.innerHTML = '<p style="color: #888; text-align: center; margin-top: 20px; font-size: 0.9rem;">ไม่พบชื่อเพื่อนที่ค้นหา</p>';
        return;
    }

    chatList.innerHTML = filteredUsers.map(u => `
        <div class="chat-user-item" onclick="openDirectChat(${u.id})">
            <img src="${u.avatar}" class="chat-user-avatar" alt="${u.name}">
