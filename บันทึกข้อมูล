    flex-direction: column;
    align-items: center;
    cursor: pointer;
    flex-shrink: 0;
}

.story-ring {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
}

.story-thumb {
    width: 100%;
