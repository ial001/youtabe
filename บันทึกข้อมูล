1. อัปเดตไฟล์ script.js (เพิ่มระบบแถบอิโมจิเลือกธีมสี)
นำโค้ดชุดนี้ไปวางทับส่วนของ ระบบกดค้างเปลี่ยนธีมสีแชท ในไฟล์ script.js เดิมของคุณ:

JavaScript
// --- ระบบกดค้างแสดงแถบอิโมจิเลือกธีมสี (Emoji Theme Bar) ---

// สร้างแถบป๊อบอัปอิโมจิเลือกธีมสีไว้ใน DOM
const themeEmojiBarHTML = `
    <div id="theme-emoji-bar" class="theme-emoji-bar">
        <span class="theme-emoji-item" onclick="changeChatTheme('default')" title="มืดคลาสสิก">⬛</span>
        <span class="theme-emoji-item" onclick="changeChatTheme('instagram')" title="อินสตาแกรม">🟣</span>
        <span class="theme-emoji-item" onclick="changeChatTheme('cyberpunk')" title="ไซเบอร์พังก์">ชมพู</span>
        <span class="theme-emoji-item" onclick="changeChatTheme('emerald')" title="เอเมอรัลด์">🟢</span>
        <span class="theme-emoji-item" onclick="changeChatTheme('sunset')" title="ซันเซ็ต">🟠</span>
        <span class="theme-emoji-item" onclick="changeChatTheme('ocean')" title="โอเชี่ยน">🔵</span>
    </div>
`;
document.body.insertAdjacentHTML('beforeend', themeEmojiBarHTML);

const themeEmojiBar = document.getElementById('theme-emoji-bar');
const chatContainer = document.getElementById('chat-messages');

let longPressTimer;
const LONG_PRESS_DURATION = 400; // เวลาที่ต้องกดค้าง (0.4 วินาที)

if (chatContainer) {
    // แสดงแถบอิโมจิตรงตำแหน่งที่กดค้าง
    function showEmojiThemeBar(x, y) {
        themeEmojiBar.style.left = `${x}px`;
        themeEmojiBar.style.top = `${y - 50}px`; // ลอยขึ้นเหนือจุดที่กดเล็กน้อย
        themeEmojiBar.classList.add('show');
    }

    // ซ่อนแถบเมื่อคลิกพื้นที่อื่น
    document.addEventListener('click', (e) => {
        if (!themeEmojiBar.contains(e.target)) {
            themeEmojiBar.classList.remove('show');
        }
    });

    // ตรวจจับการกดค้างด้วยเมาส์ (Desktop)
    chatContainer.addEventListener('mousedown', (e) => {
        longPressTimer = setTimeout(() => {
            showEmojiThemeBar(e.clientX, e.clientY);
        }, LONG_PRESS_DURATION);
    });

    chatContainer.addEventListener('mouseup', () => clearTimeout(longPressTimer));
    chatContainer.addEventListener('mouseleave', () => clearTimeout(longPressTimer));

    // ตรวจจับการกดค้างด้วยนิ้ว (Mobile Touch)
    chatContainer.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        longPressTimer = setTimeout(() => {
            showEmojiThemeBar(touch.clientX, touch.clientY);
        }, LONG_PRESS_DURATION);
    });

    chatContainer.addEventListener('touchend', () => clearTimeout(longPressTimer));
    chatContainer.addEventListener('touchmove', () => clearTimeout(longPressTimer));
}

// ฟังก์ชันเปลี่ยนธีมสีแชทตามอิโมจิที่เลือก
window.changeChatTheme = function(themeName) {
    if (!chatContainer) return;
    
    // ลบ class ธีมเก่าออก
    chatContainer.className = 'chat-messages';
    
    // ใส่ class ธีมใหม่
    if (themeName !== 'default') {
        chatContainer.classList.add(`theme-${themeName}`);
    }

    // บันทึกการเลือกไว้ใน LocalStorage
    localStorage.setItem('streamgram_chat_theme', themeName);
    
    // ซ่อนแถบอิโมจิ
    if (themeEmojiBar) themeEmojiBar.classList.remove('show');
};

// โหลดธีมเดิมเมื่อเริ่มระบบ
window.addEventListener('DOMContentLoaded', () => {
    const savedTheme = localStorage.getItem('streamgram_chat_theme');
    if (savedTheme && chatContainer) {
        changeChatTheme(savedTheme);
    }
});
