}

// เรนเดอร์รายการแชท
function renderChatList() {
    const chatList = document.getElementById('ig-chat-list');
    if (!chatList) return;
    chatList.innerHTML = chatUsersData.map(u => `
        <div class="chat-user-item" onclick="openDirectChat(${u.id})">
