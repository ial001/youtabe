นำโค้ดนี้ไปคัดลอกวางทับในไฟล์ style.css ของคุณทั้งหมดได้เลยครับ:

CSS
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #0f0f0f;
    color: #f1f1f1;
}

/* Navbar */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 60px;
    background-color: #212121;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    z-index: 100;
}

.nav-left, .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
}

.logo {
    font-size: 1.2rem;
    color: #ff0000;
    cursor: pointer;
}

.menu-icon {
    font-size: 1.2rem;
    cursor: pointer;
}

.nav-center {
    display: flex;
    width: 40%;
    max-width: 600px;
}

.nav-center input {
    width: 100%;
    padding: 8px 15px;
    background: #121212;
    border: 1px solid #303030;
    border-radius: 20px 0 0 20px;
    color: #fff;
    outline: none;
}

.search-btn {
    padding: 0 20px;
    background: #303030;
    border: 1px solid #303030;
    border-radius: 0 20px 20px 0;
    color: #fff;
    cursor: pointer;
}

.icon-btn {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.2rem;
    cursor: pointer;
}

.user-avatar {
    width: 32px;
    height: 32px;
    background: #555;
    border-radius: 50%;
    cursor: pointer;
}

/* Layout */
.main-container {
    display: flex;
    margin-top: 60px;
}

.sidebar {
    width: 240px;
    height: calc(100vh - 60px);
    position: fixed;
    background-color: #212121;
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sidebar-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 10px 15px;
    color: #fff;
    text-decoration: none;
    border-radius: 10px;
    transition: 0.2s;
}

.sidebar-item:hover, .sidebar-item.active {
    background-color: #3f3f3f;
}

.sidebar hr {
    border: 0;
    border-top: 1px solid #383838;
    margin: 10px 0;
}

.content {
    margin-left: 240px;
    padding: 20px;
    width: calc(100% - 240px);
}

/* Page Views Control */
.page-view {
    display: none;
}

.page-view.active-view {
    display: block;
}

/* Channel Header Box */
.channel-header-box {
    display: flex;
    align-items: center;
    gap: 20px;
    background: #1a1a1a;
    padding: 20px;
    border-radius: 12px;
}

/* Shorts Container */
.shorts-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 15px;
}

.short-card {
    height: 350px;
    background: #1f1f1f;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 15px;
    background-size: cover;
    background-position: center;
    cursor: pointer;
}

.short-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
}

.short-info {
    position: relative;
    z-index: 2;
}

/* Stories Bar */
.stories-wrapper {
    overflow-x: auto;
    padding-bottom: 15px;
    margin-bottom: 20px;
    scrollbar-width: none;
}
.stories-wrapper::-webkit-scrollbar {
    display: none;
}

.stories-container {
    display: flex;
    gap: 15px;
}

.story-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    flex-shrink: 0;
}

.story-ring {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
}

.story-thumb {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #0f0f0f;
}

.story-card span {
    font-size: 0.8rem;
    margin-top: 5px;
    color: #aaa;
    max-width: 70px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Video Grid */
.video-section h2, .page-view h2 {
    margin-bottom: 15px;
    font-size: 1.2rem;
}

.video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
}

.video-card {
    background: #1f1f1f;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s;
}

.video-card:hover {
    transform: scale(1.02);
}

.video-thumbnail {
    width: 100%;
    aspect-ratio: 16/9;
    background: #333;
    object-fit: cover;
}

.video-info-container {
    padding: 12px;
    display: flex;
    gap: 12px;
}

.channel-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #777;
    flex-shrink: 0;
}

.video-details h3 {
    font-size: 0.95rem;
    margin-bottom: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.video-details p {
    font-size: 0.8rem;
    color: #aaa;
}

/* Modal General */
.modal {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.7);
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.modal-content {
    background: #212121;
    padding: 30px;
    border-radius: 12px;
    width: 500px;
    max-width: 90%;
    position: relative;
}

.close-modal {
    position: absolute;
    top: 15px; right: 20px;
    font-size: 1.5rem;
    cursor: pointer;
}

#upload-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 15px;
}

.upload-dropzone {
    border: 2px dashed #555;
    padding: 30px;
    text-align: center;
    border-radius: 8px;
    cursor: pointer;
}

.upload-dropzone i {
    font-size: 2.5rem;
    color: #aaa;
    margin-bottom: 10px;
}

#upload-form input[type="text"], #upload-form textarea {
    padding: 10px;
    background: #121212;
    border: 1px solid #444;
    border-radius: 6px;
    color: #fff;
    outline: none;
}

.primary-btn {
    padding: 10px;
    background: #3ea6ff;
    color: #000;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}

/* Settings Modal Styles */
.settings-box, .support-box {
    width: 450px;
    max-height: 85vh;
    overflow-y: auto;
}

.settings-section {
    margin-top: 20px;
