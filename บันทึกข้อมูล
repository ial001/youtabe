    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10;
}

.mini-avatar {
    width: 30px; height: 30px; border-radius: 50%; background: #666;
}

.story-content-display {
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
