    { id: 3, name: 'Grand Theft Auto V', playTime: '45 นาที', date: '28 ตุลาคม 2026', icon: 'fa-car' },
    { id: 4, name: 'Minecraft', playTime: '4 ชั่วโมง 10 นาที', date: '25 ตุลาคม 2026', icon: 'fa-cube' }
];

// เรนเดอร์รายการประวัติการเล่นเกม
function renderGameActivity() {
    const activityContainer = document.getElementById('game-activity-list');
    if (!activityContainer) return;

    activityContainer.innerHTML = gameActivityData.map(item => `
        <div class="game-activity-card">
            <div class="game-info">
                <div class="game-icon">
                    <i class="fa-solid ${item.icon || 'fa-gamepad'}"></i>
                </div>
                <div class="game-details">
                    <h4>${item.game || item.name}</h4>
                    <p><i class="fa-regular fa-calendar"></i> เล่นเมื่อ: ${item.date}</p>
                </div>
            </div>
            <div class="game-time-badge">
                <i class="fa-regular fa-clock"></i> ${item.playTime}
            </div>
        </div>
    `).join('');
}

