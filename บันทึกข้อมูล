    if (!ticketsList) return;
    if (supportTickets.length === 0) {
        ticketsList.innerHTML = '<p style="color: #666;">ยังไม่มีประวัติการติดต่อ</p>';
        return;
    }

    ticketsList.innerHTML = supportTickets.map(ticket => `
