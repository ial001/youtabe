        e.preventDefault();
        const targetPage = item.getAttribute('data-page');

        sidebarItems.forEach(i => i.classList.remove('active'));
        item.classList.add('active');

        pageViews.forEach(view => {
            if (view.id === `view-${targetPage}`) {
                view.classList.add('active-view');
