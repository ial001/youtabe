    gap: 20px;
    background: #1a1a1a;
    padding: 20px;
    border-radius: 12px;
}

/* Shorts Container */
.shorts-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 15px;
}

.short-card {
    height: 350px;
    background: #1f1f1f;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 15px;
    background-size: cover;
    background-position: center;
    cursor: pointer;
}

.short-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
}

.short-info {
    position: relative;
    z-index: 2;
}

/* Stories Bar */
.stories-wrapper {
    overflow-x: auto;
