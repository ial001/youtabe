let longPressTimer;

const LONG_PRESS_DURATION = 500; // เวลาที่ต้องกดค้าง (500 มิลลิวินาที = 0.5 วินาที)



if (chatContainer) {

    // ฟังก์ชันเปิด Context Menu ตรงจุดที่กด

    function showContextMenu(x, y) {

        contextMenu.style.left = `${x}px`;

        contextMenu.style.top = `${y}px`;

        contextMenu.style.display = 'block';

    }



    // ปิด Context Menu เมื่อคลิกที่อื่น

    document.addEventListener('click', () => {

        contextMenu.style.display = 'none';

    });



    // Event listeners สำหรับกดค้างบนระบบ Desktop (Mouse)

    chatContainer.addEventListener('mousedown', (e) => {

        longPressTimer = setTimeout(() => {

            showContextMenu(e.clientX, e.clientY);

        }, LONG_PRESS_DURATION);

    });



    chatContainer.addEventListener('mouseup', () => clearTimeout(longPressTimer));

    chatContainer.addEventListener('mouseleave', () => clearTimeout(longPressTimer));



    // Event listeners สำหรับกดค้างบนมือถือ (Touch)

    chatContainer.addEventListener('touchstart', (e) => {

        const touch = e.touches[0];

        longPressTimer = setTimeout(() => {

            showContextMenu(touch.clientX, touch.clientY);

        }, LONG_PRESS_DURATION);

    });



    chatContainer.addEventListener('touchend', () => clearTimeout(longPressTimer));

    chatContainer.addEventListener('touchmove', () => clearTimeout(longPressTimer));

}



