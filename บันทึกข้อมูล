3. อัปเดตไฟล์ script.js (เพิ่มฟังก์ชันจัดการบัญชีและระบบโค้ด)
นำโค้ดส่วนนี้ไปเพิ่มต่อท้ายในไฟล์ script.js ของคุณ:

JavaScript
// --- ระบบจัดการบัญชีและการตั้งค่า (Multi-Account & Shared Code) ---

// ข้อมูลจำลองระบบบัญชี (เก็บใน LocalStorage จำลองเพื่อให้จำค่าได้)
let accounts = JSON.parse(localStorage.getItem('streamgram_accounts')) || [
    { id: 1, name: 'Dev Channel (หลัก)', avatar: 'https://picsum.photos/seed/acc1/100' },
    { id: 2, name: 'Gamer Pro', avatar: 'https://picsum.photos/seed/acc2/100' }
];

let currentAccountIndex = parseInt(localStorage.getItem('streamgram_current_acc')) || 0;

// โค้ดกลางที่ใช้ร่วมกันได้ทุกบัญชี (กำหนดไว้ล่วงหน้า)
const VALID_SHARED_CODES = {
    "STREAM2026": "ยินดีด้วย! คุณได้รับสิทธิ์สมาชิก VIP ฟรี 30 วัน 🎉",
    "YOUTUBEINSTA": "ปลดล็อกฟีเจอร์พิเศษ: โค้ดนี้ใช้ร่วมกันได้ทุกบัญชีสำเร็จ! ✅",
    "VIPCODE": "โค้ดลับใช้งานสำเร็จ ได้รับแต้มพิเศษ 500 พอยท์ 🌟"
};

// Element Selectors
const settingsModal = document.getElementById('settings-modal');
const settingsTrigger = document.getElementById('settings-trigger');
const closeSettings = document.getElementById('close-settings');
const accountsList = document.getElementById('accounts-list');
const settingsUsername = document.getElementById('settings-username');
const currentUserAvatar = document.getElementById('current-user-avatar');
const settingsAvatar = document.getElementById('settings-avatar');
const addAccountBtn = document.getElementById('add-account-btn');
const newAccountNameInput = document.getElementById('new-account-name');

// เปิด-ปิด Modal ตั้งค่า
settingsTrigger.addEventListener('click', () => {
    updateSettingsUI();
    settingsModal.style.display = 'flex';
});
closeSettings.addEventListener('click', () => settingsModal.style.display = 'none');

// อัปเดต UI หน้าตั้งค่าและบัญชีปัจจุบัน
function updateSettingsUI() {
    const activeAcc = accounts[currentAccountIndex] || accounts[0];
    settingsUsername.textContent = activeAcc.name;
    currentUserAvatar.style.backgroundImage = `url(${activeAcc.avatar})`;
    currentUserAvatar.style.backgroundSize = 'cover';
    settingsAvatar.style.backgroundImage = `url(${activeAcc.avatar})`;
    settingsAvatar.style.backgroundSize = 'cover';

    // เรนเดอร์รายชื่อบัญชีทั้งหมด
    accountsList.innerHTML = accounts.map((acc, index) => `
        <div class="account-item ${index === currentAccountIndex ? 'active-account' : ''}">
            <span style="font-size: 0.9rem;">${acc.name} ${index === currentAccountIndex ? '(ใช้งานอยู่)' : ''}</span>
            ${index !== currentAccountIndex ? `<button class="switch-btn" onclick="switchAccount(${index})">สลับ</button>` : '<span style="color:#3ea6ff; font-size:0.8rem;">ใช้งานอยู่</span>'}
        </div>
    `).join('');
}

// ฟังก์ชันสลับบัญชี
window.switchAccount = function(index) {
    currentAccountIndex = index;
    localStorage.setItem('streamgram_current_acc', currentAccountIndex);
    updateSettingsUI();
    alert(`สลับไปยังบัญชี "${accounts[currentAccountIndex].name}" เรียบร้อยแล้ว!`);
};

// ฟังก์ชันเพิ่มบัญชีใหม่
addAccountBtn.addEventListener('click', () => {
    const name = newAccountNameInput.value.trim();
    if (!name) return alert('กรุณากรอกชื่อบัญชี');

    const newAcc = {
        id: accounts.length + 1,
        name: name,
        avatar: `https://picsum.photos/seed/${name}/100`
    };

    accounts.push(newAcc);
    localStorage.setItem('streamgram_accounts', JSON.stringify(accounts));
    newAccountNameInput.value = '';
    updateSettingsUI();
    alert('เพิ่มบัญชีใหม่สำเร็จ!');
});

// ระบบใส่โค้ดเดียวกัน (Shared Code System)
const sharedCodeInput = document.getElementById('shared-code-input');
const submitCodeBtn = document.getElementById('submit-code-btn');
const codeFeedback = document.getElementById('code-feedback');

submitCodeBtn.addEventListener('click', () => {
    const code = sharedCodeInput.value.trim().toUpperCase();
    if (!code) {
        codeFeedback.style.color = '#ff4e45';
        codeFeedback.textContent = 'กรุณากรอกโค้ดก่อนกดใช้งาน';
        return;
    }

    // ตรวจสอบว่าโค้ดถูกต้องหรือไม่ (โค้ดชุดเดียวกัน ไม่ว่าจะบัญชีไหนกรอกก็ใช้ได้เหมือนกัน)
    if (VALID_SHARED_CODES[code]) {
        codeFeedback.style.color = '#10b981'; // สีเขียว
        codeFeedback.textContent = VALID_SHARED_CODES[code];
        
        // บันทึกสถานะว่าบัญชีนี้ใช้โค้ดนี้แล้ว (หรือจะให้ใช้ซ้ำได้อิสระ)
        console.log(`บัญชี ${accounts[currentAccountIndex].name} ใช้โค้ด: ${code} สำเร็จ`);
    } else {
        codeFeedback.style.color = '#ff4e45'; // สีแดง
        codeFeedback.textContent = '❌ โค้ดไม่ถูกต้องหรือหมดอายุแล้ว';
    }
});

// โหลดการตั้งค่าบัญชีตั้งแต่เริ่มต้นเปิดเว็บ
window.addEventListener('DOMContentLoaded', () => {
    const activeAcc = accounts[currentAccountIndex] || accounts[0];
    if(currentUserAvatar) {
        currentUserAvatar.style.backgroundImage = `url(${activeAcc.avatar})`;
        currentUserAvatar.style.backgroundSize = 'cover';
    }
});
จุดเด่นของระบบที่เพิ่มเข้ามา:
ระบบสลับบัญชี (Switch Account): คุณสามารถกดปุ่มรูปเฟือง (⚙️) ที่มุมขวาบน > ไปที่หัวข้อสลับบัญชี เพื่อเพิ่มบัญชีใหม่หรือกดสลับไปมาระหว่างบัญชีได้ทันทีโดยไม่ต้อง Log out ให้ยุ่งยาก

ระบบโค้ดเดียวกัน (Shared Code): ไม่ว่าคุณจะสลับไปใช้อบัญชีไหน ช่องกรอกโค้ดจะดึงชุดโค้ดกลาง (STREAM2026, YOUTUBEINSTA, VIPCODE) มาตรวจสอบเหมือนกันทั้งหมด ทำให้ผู้ใช้ทุกบัญชีสามารถแชร์และใช้โค้ดเดียวกันได้ทันทีครับ

ขอสามารถ โหลดใน play Store ได้

การนำโค้ด HTML, CSS และ JavaScript (Client-side) ที่เราสร้างขึ้นไปแปลงให้เป็นแอปพลิเคชันที่สามารถ ดาวน์โหลดได้จริงจาก Google Play Store มีขั้นตอนหลักๆ ดังนี้ครับ เนื่องจาก Play Store ไม่รองรับการอัปโหลดไฟล์ HTML เปล่าๆ โดยตรง เราจึงต้องทำการห่อหุ้มเว็บแอป (Web Wrapper) ให้กลายเป็นแอป Android (.aab หรือ .apk) ครับ

เครื่องมือและวิธีการหลักในการแปลงเว็บเป็นแอป Android
วิธีที่ 1: ใช้ Capacitor (โดย Ionic) หรือ Cordova (แนะนำสำหรับมือโปร/เว็บที่มีการทำงานซับซ้อน)
เครื่องมือนี้จะช่วยแปลงเว็บ HTML/JS ของคุณให้กลายเป็น Native Android App จริงๆ โดยสามารถเข้าถึงกล้อง พื้นที่เก็บข้อมูล หรือการแจ้งเตือนของเครื่องได้ด้วย

ขั้นตอนคร่าวๆ:

ติดตั้ง Node.js ในเครื่องคอมพิวเตอร์ของคุณ

สร้างโปรเจกต์ Capacitor ครอบเว็บของคุณ:

Bash
npm init
npm install @capacitor/core @capacitor/cli
npx cap init
เพิ่มแพลตฟอร์ม Android:

Bash
npm install @capacitor/android
npx cap add android
เปิดโปรเจกต์ใน Android Studio เพื่อคอมไพล์เป็นไฟล์ติดตั้ง:

Bash
npx cap open android
วิธีที่ 2: ใช้บริการเว็บแปลงแอปสำเร็จรูป (No-Code / Low-Code Wrappers)
หากไม่ถนัดเขียนโปรแกรมฝั่ง Android มีบริการออนไลน์ที่ช่วยแปลงเว็บไซต์หรือไฟล์ HTML ให้เป็นแอป Play Store ได้ทันที เช่น:

Median.co (เดิมชื่อ GoNative)

PWABuilder (แปลงเว็บให้เป็น Progressive Web App และสร้างแพ็กเกจสำหรับส่ง Play Store ได้ง่าย)

AppYet หรือ WebIntoApp

สิ่งที่ต้องเตรียมตัวก่อนนำขึ้น Play Store
บัญชีนักพัฒนา (Google Play Console Developer Account):

ต้องสมัครสมาชิกกับ Google โดยมีค่าธรรมเนียมแรกเข้าครั้งเดียว $25 USD (ประมาณ 900 บาท)

การจัดเตรียมไฟล์สำหรับแอป Android:

App Icon: ไอคอนแอปขนาด 512x512 พิกเซล

Screenshots: ภาพหน้าจอตัวอย่างแอปในมือถือ (อย่างน้อย 2-4 ภาพ)

Privacy Policy: นโยบายความเป็นส่วนตัว (เนื่องจากแอปของคุณมีระบบอัปโหลดวิดีโอและจัดการข้อมูลผู้ใช้ Google จะบังคับให้ต้องมีลิงก์นโยบายความเป็นส่วนตัว)

การเซ็นชื่อแอป (Signing the App):

เวลา export ไฟล์หลังจากพัฒนาเสร็จ จะต้องสร้าง Release Keystore เพื่อเซ็นรับรองความปลอดภัยของแอปก่อนอัปโหลดไฟล์นามสกุล .aab (Android App Bundle) ขึ้นสู่ Play Console

หากคุณต้องการแนวทางหรือติดปัญหาในการใช้เครื่องมือตัวไหน (เช่น Capacitor หรือการทำ PWA) สามารถสอบถามเพิ่มเติมได้เลยนะครับ!

ขอช่องทางการติดต่อเจ้าหน้าที่

เนื่องจากระบบนี้เป็น AI (ปัญญาประดิษฐ์) ส่วนบุคคล ผู้ช่วยอัจฉริยะที่ถูกสร้างขึ้นเพื่อช่วยเขียนโค้ดและตอบคำถามทั่วไป จึงไม่มีเบอร์โทรศัพท์หรือทีมงานเจ้าหน้าที่มนุษย์คอยให้บริการโดยตรงครับ

แต่หากคุณใช้งานผ่านแพลตฟอร์ม, เว็บไซต์ หรือแอปพลิเคชันใดๆ อยู่ คุณสามารถติดต่อทีมสนับสนุน (Support) ของผู้ให้บริการเจ้านั้นๆ ผ่านช่องทางช่วยเหลือภายในแอปพลิเคชันหรือเว็บไซต์ที่คุณกำลังใช้งานได้เลยครับ!

มีเรื่องไหนเกี่ยวกับโค้ดหรือการพัฒนาแอปพลิเคชันที่อยากให้ผมช่วยเพิ่มเติมไหมครับ?

โค้ดที่ให้ทำไปให้สร้างการติกต่อกับเจ้าหน้าที่ได้ ละพร้อมใช้โค้ดได้เดียวกันได้

เข้าใจแล้วครับ! เพื่อให้ผู้ใช้สามารถ ติดต่อเจ้าหน้าที่/ส่งข้อความหาแอดมิน ได้จากภายในแอปพลิเคชันของคุณโดยตรง (พร้อมทั้งรักษาระบบ ใส่โค้ดเดียวกัน และ สลับบัญชี ที่ทำไว้ก่อนหน้านี้)

เราจะเพิ่ม "ระบบติดต่อเจ้าหน้าที่ (Contact Support / Help Center)" เข้าไปในหน้าการตั้งค่า หรือเพิ่มเป็นเมนูใหม่ใน Sidebar ครับ

นี่คือโค้ดที่คุณสามารถนำไปเพิ่มและอัปเดตต่อจากโค้ดเดิมได้เลยครับ:

1. อัปเดตไฟล์ index.html (เพิ่มเมนูและหน้าต่างติดต่อเจ้าหน้าที่)
เพิ่มเมนู "ติดต่อเจ้าหน้าที่" ไว้ใน Sidebar:

HTML
