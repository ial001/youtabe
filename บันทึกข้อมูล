นำโค้ดระบบกดค้างเปิดเมนูและเปลี่ยนธีมสีนี้ไปวางต่อท้ายไฟล์ script.js:

JavaScript
// --- ระบบกดค้างเปลี่ยนธีมสีแชท (Long Press for Chat Theme) ---

// สร้าง Context Menu สำหรับกดค้างไว้ใน DOM
const contextMenuHTML = `
    <div id="chat-context-menu" class="chat-context-menu">
        <div class="chat-context-menu-item" id="ctx-change-theme">
            <i class="fa-solid fa-palette"></i> ธีม
        </div>
    </div>
`;
document.body.insertAdjacentHTML('beforeend', contextMenuHTML);

const contextMenu = document.getElementById('chat-context-menu');
const ctxChangeThemeBtn = document.getElementById('ctx-change-theme');
const themeModal = document.getElementById('chat-theme-modal');
const closeThemeModalBtn = document.getElementById('close-theme-modal');
const chatContainer = document.getElementById('chat-messages');

let longPressTimer;
const LONG_PRESS_DURATION = 500; // เวลาที่ต้องกดค้าง (500 มิลลิวินาที = 0.5 วินาที)

if (chatContainer) {
    // ฟังก์ชันเปิด Context Menu ตรงจุดที่กด
    function showContextMenu(x, y) {
        contextMenu.style.left = `${x}px`;
        contextMenu.style.top = `${y}px`;
        contextMenu.style.display = 'block';
    }

    // ปิด Context Menu เมื่อคลิกที่อื่น
    document.addEventListener('click', () => {
        contextMenu.style.display = 'none';
    });

    // Event listeners สำหรับกดค้างบนระบบ Desktop (Mouse)
    chatContainer.addEventListener('mousedown', (e) => {
        longPressTimer = setTimeout(() => {
            showContextMenu(e.clientX, e.clientY);
        }, LONG_PRESS_DURATION);
    });

    chatContainer.addEventListener('mouseup', () => clearTimeout(longPressTimer));
    chatContainer.addEventListener('mouseleave', () => clearTimeout(longPressTimer));

    // Event listeners สำหรับกดค้างบนมือถือ (Touch)
    chatContainer.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        longPressTimer = setTimeout(() => {
            showContextMenu(touch.clientX, touch.clientY);
        }, LONG_PRESS_DURATION);
    });

    chatContainer.addEventListener('touchend', () => clearTimeout(longPressTimer));
    chatContainer.addEventListener('touchmove', () => clearTimeout(longPressTimer));
}

// เมื่อกดเลือกเมนู "ธีม" ให้เปิด Modal เลือกสี
if (ctxChangeThemeBtn) {
    ctxChangeThemeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        contextMenu.style.display = 'none';
        if (themeModal) themeModal.style.display = 'flex';
    });
}

if (closeThemeModalBtn) {
    closeThemeModalBtn.addEventListener('click', () => {
        themeModal.style.display = 'none';
    });
}

// ฟังก์ชันสลับธีมสีแชท
window.changeChatTheme = function(themeName) {
    if (!chatContainer) return;
    
    // ลบ class ธีมเก่าออกทั้งหมด
    chatContainer.className = 'chat-messages';
    
    // ใส่ class ธีมใหม่
    if (themeName !== 'default') {
        chatContainer.classList.add(`theme-${themeName}`);
    }

    // บันทึกความจำลง LocalStorage
    localStorage.setItem('streamgram_chat_theme', themeName);
    
    if (themeModal) themeModal.style.display = 'none';
};

// โหลดธีมสีที่เคยบันทึกไว้เมื่อเปิดเว็บ
window.addEventListener('DOMContentLoaded', () => {
    const savedTheme = localStorage.getItem('streamgram_chat_theme');
    if (savedTheme && chatContainer) {
        changeChatTheme(savedTheme);
    }
});
