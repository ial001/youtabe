3. ไฟล์ script.js (การทำงานของระบบติดต่อเจ้าหน้าที่ + โค้ดกลาง)
เพิ่มโค้ด JavaScript ต่อไปนี้ลงในไฟล์ script.js เพื่อประมวลผลการส่งข้อความหาเจ้าหน้าที่และบันทึกข้อมูลร่วมกัน:

JavaScript
// --- ระบบติดต่อเจ้าหน้าที่ (Contact Support System) ---

// ข้อมูลจำลองตั๋วการติดต่อ (แชร์ข้อมูลร่วมกันทุกบัญชีผ่าน LocalStorage)
let supportTickets = JSON.parse(localStorage.getItem('streamgram_tickets')) || [];

// Element Selectors สำหรับ Modal ติดต่อเจ้าหน้าที่
const supportModal = document.getElementById('support-modal');
const supportTrigger = document.getElementById('support-trigger');
const closeSupport = document.getElementById('close-support');
const supportForm = document.getElementById('support-form');
const supportUserDisplay = document.getElementById('support-user-display');
const ticketsList = document.getElementById('tickets-list');

// เปิด Modal ติดต่อเจ้าหน้าที่
if (supportTrigger) {
    supportTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        const activeAcc = accounts[currentAccountIndex] || accounts[0];
        supportUserDisplay.value = activeAcc.name;
        renderSupportTickets();
        supportModal.style.display = 'flex';
    });
}

closeSupport.addEventListener('click', () => {
    supportModal.style.display = 'none';
});

// ฟังก์ชันเรนเดอร์ประวัติการติดต่อ
function renderSupportTickets() {
    if (supportTickets.length === 0) {
        ticketsList.innerHTML = '<p style="color: #666;">ยังไม่มีประวัติการติดต่อ</p>';
        return;
    }

    ticketsList.innerHTML = supportTickets.map(ticket => `
        <div class="ticket-item">
            <strong>[${ticket.topic}] จาก: ${ticket.sender}</strong>
            <p>${ticket.message}</p>
            <span style="font-size:0.7rem; color:#666;">ส่งเมื่อ: ${ticket.time} | สถานะ: รอดำเนินการ</span>
        </div>
    `).join('');
}

// ระบบส่งข้อความหาเจ้าหน้าที่
supportForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const activeAcc = accounts[currentAccountIndex] || accounts[0];
    const topicSelect = document.getElementById('support-topic');
    const topicText = topicSelect.options[topicSelect.selectedIndex].text;
    const message = document.getElementById('support-message').value.trim();

    if (!message) return alert('กรุณากรอกรายละเอียดข้อความ');

    // สร้างข้อมูล Ticket ใหม่
    const newTicket = {
        id: Date.now(),
        sender: activeAcc.name,
        topic: topicText,
        message: message,
        time: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })
    };

    supportTickets.unshift(newTicket);
    localStorage.setItem('streamgram_tickets', JSON.stringify(supportTickets));

    renderSupportTickets();
    supportForm.reset();
    alert('ส่งข้อความถึงเจ้าหน้าที่เรียบร้อยแล้ว! ทีมงานจะดำเนินการตรวจสอบโดยเร็วที่สุด');
});
สรุปจุดเด่นของระบบที่เพิ่มเข้ามา:
ระบบติดต่อเจ้าหน้าที่ในตัว (Support Ticket System): มีแบบฟอร์มให้ผู้ใช้งานเลือกหัวข้อปัญหา และพิมพ์ข้อความส่งหาทีมงานได้ทันที

รองรับการใช้โค้ดและบัญชีร่วมกัน: ทุกบัญชีที่สลับใช้งานจะเห็นประวัติการส่งเรื่องถึงเจ้าหน้าที่ และสามารถใช้ชุด Shared Code เดียวกันในหน้าตั้งค่าได้แบบไร้รอยต่อ

ขอโค้ด THML,css,javascript ขอโค้ดเดิมไม่ต้องการแก้ไขอะไรทั้งนั้น แก้ฉะเพราะที่บอกไปโค้ดเก่าห้ามแตะจนกว่าจะบอก สร้างหน้าเว๊บไซต์ข้างในให้เข้าไปใช้งานได้ละ ต้องใช้กับ แอพ github ได้โดยใช้กับโค้ดเก่านั้นได้

การเชื่อมต่อเมนูใน Sidebar ให้กดแล้วสลับหน้าใช้งานภายใน (สำรวจ, คลิปสั้น, การติดตาม, ช่องของคุณ, ประวัติการเข้าชม) โดยไม่แตะต้องโครงสร้างหรือฟังก์ชันเดิมเลย สามารถทำได้ด้วยการเพิ่ม Navigation Controller เข้าไปควบคุม content ใน script.js และเพิ่ม CSS เล็กน้อยสำหรับรองรับการซ่อน/แสดงหน้าครับ

